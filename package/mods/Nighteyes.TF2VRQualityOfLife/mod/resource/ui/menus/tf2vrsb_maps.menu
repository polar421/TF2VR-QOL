"resource/ui/menus/tf2vrsb_maps.menu"
{
	menu
	{
		ControlName Frame
		xpos 0
		ypos 0
		zpos 3
		wide f0
		tall f0
		autoResize 0
		visible 1
		enabled 1
		pinCorner 0
		PaintBackgroundType 0
		infocus_bgcolor_override "0 0 0 0"
		outoffocus_bgcolor_override "0 0 0 0"

		Vignette
		{
			ControlName ImagePanel
			InheritProperties MenuVignette
		}

		ImgTopBar
		{
			ControlName ImagePanel
			InheritProperties MenuTopBar
		}

		Title
		{
			ControlName Label
			InheritProperties MenuTitle
			labelText "TF2VR CAMPAIGN SANDBOX"
		}

		Panel
		{
			ControlName Label
			labelText ""
			zpos -1
			wide 1100
			tall 760
			xpos 120
			ypos 240
			paintbackground 1
			bgcolor_override "8 10 12 236"
		}

		AccentTop
		{
			ControlName Label
			labelText ""
			wide 1100
			tall 6
			paintbackground 1
			bgcolor_override "242 141 28 255"
			xpos 120
			ypos 240
		}

		PanelHeader
		{
			ControlName Label
			labelText "MAPS & ENVIRONMENTS"
			font Default_41
			allcaps 1
			fgcolor_override "255 255 255 255"
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 152
			ypos 266
		}

		HeaderRule
		{
			ControlName Label
			labelText ""
			wide 1036
			tall 2
			paintbackground 1
			bgcolor_override "96 104 112 255"
			xpos 152
			ypos 338
		}

		SubHeader
		{
			ControlName Label
			labelText "SEARCH NAME, ID, MODE OR SOURCE // CATEGORY FILTERS // FAVORITES SAVE LOCALLY // TRAVEL DISABLED"
			font Default_21
			fgcolor_override "242 141 28 255"
			allcaps 1
			xpos 152
			ypos 350
		}

		SearchEntry
		{
			ControlName TextEntry
			xpos 152
			ypos 376
			zpos 100
			wide 380
			tall 36
			visible 1
			enabled 1
			textHidden 0
			editable 1
			maxchars 48
			NumericInputOnly 0
			textAlignment west
			font Default_21
			keyboardTitle "SEARCH MAP CATALOG"
			keyboardDescription "TYPE A MAP NAME, ID, MODE, CATEGORY OR SOURCE"
			allowRightClickMenu 0
			allowSpecialCharacters 0
			unicode 0
			navDown Map0
			navRight CategorySwitch
		}

		CategorySwitch
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 260
			xpos 552
			ypos 376
			ConVar "tf2vrsb_map_category"
			list
			{
				"ALL MAPS" 0
				"CAMPAIGN" 1
				"MULTIPLAYER" 2
				"LIVE FIRE / COLISEUM" 3
				"LOBBY / TEST" 4
			}
			navLeft SearchEntry
			navRight FavoritesSwitch
			navDown Map0
		}

		FavoritesSwitch
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			classname ModButton
			textAlignment west
			wide 170
			tall 36
			xpos 832
			ypos 376
			labelText "SHOW: ALL MAPS"
			navLeft CategorySwitch
			navRight FavoriteSelected
			navDown Map0
			scriptID "13"
		}

		FavoriteSelected
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			classname ModButton
			textAlignment west
			wide 166
			tall 36
			xpos 1022
			ypos 376
			labelText "ADD FAVORITE"
			navLeft FavoritesSwitch
			navDown Map0
			scriptID "14"
		}

