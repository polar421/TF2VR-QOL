		SearchEntry
		{
			ControlName TextEntry
			xpos 152
			ypos 378
			zpos 100
			wide 430
			tall 38
			visible 1
			enabled 1
			textHidden 0
			editable 1
			maxchars 48
			NumericInputOnly 0
			textAlignment west
			font Default_21
			keyboardTitle "SEARCH NPC CATALOG"
			keyboardDescription "TYPE A NAME, CATEGORY, CLASS OR AI SETTINGS IDENTIFIER"
			allowRightClickMenu 0
			allowSpecialCharacters 0
			unicode 0
			navDown Npc0
			navRight SwitchCategory
		}

		SwitchCategory
		{
			ControlName RuiButton
