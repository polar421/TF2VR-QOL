"resource/ui/menus/tf2vrbb_general.menu"
{
	menu
	{
		ControlName Frame
		xpos 0
		ypos 0
		zpos 3
		wide f0
		tall f0
		autoResize 0
		visible 1
		enabled 1
		pinCorner 0
		PaintBackgroundType 0
		infocus_bgcolor_override "0 0 0 0"
		outoffocus_bgcolor_override "0 0 0 0"

		Vignette
		{
			ControlName ImagePanel
			InheritProperties MenuVignette
		}

		ImgTopBar
		{
			ControlName ImagePanel
			InheritProperties MenuTopBar
		}

		Title
		{
			ControlName Label
			InheritProperties MenuTitle
			labelText "TF2VR QUALITY OF LIFE"
		}

		Screen
		{
			ControlName Label
			wide %100
			tall %100
			labelText ""
			visible 0
		}

		Panel
		{
			ControlName Label
			labelText ""
			zpos -1
			wide 760
			tall 800
			xpos 120
			ypos 280
			paintbackground 1
			bgcolor_override "8 10 12 232"
		}

		AccentTop
		{
			ControlName Label
			labelText ""
			wide 760
			tall 6
			paintbackground 1
			bgcolor_override "242 141 28 255"
			xpos 120
			ypos 280
		}

		PanelHeader
		{
			ControlName Label
			labelText "GENERAL OPTIONS"
			font Default_41
			allcaps 1
			fgcolor_override "255 255 255 255"
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 152
			ypos 306
		}

		HeaderRule
		{
			ControlName Label
			labelText ""
			wide 696
			tall 2
			paintbackground 1
			bgcolor_override "96 104 112 255"
			xpos 152
			ypos 376
		}

		SubHeader
		{
			ControlName Label
			labelText "Preferences that are not tied to a single bound action."
			font Default_21
			fgcolor_override "176 182 188 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 392
		}

		SwitchSprintAction
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 448
			navUp SwitchSprintStop
			navDown SwitchSprintStart
			ConVar "tf2vrbb_sprint_enabled"
			list
			{
				"OFF" 0
				"ON" 1
			}
		}

		SwitchSprintStart
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 510
			navUp SwitchSprintAction
			navDown SwitchSprintStop
			ConVar "tf2vrbb_sprint_start_cm"
			list
			{
				"5 CM" 5
				"10 CM" 10
				"15 CM" 15
				"20 CM" 20
				"25 CM" 25
				"30 CM" 30
				"35 CM" 35
				"40 CM" 40
				"45 CM" 45
				"50 CM" 50
				"55 CM" 55
				"60 CM" 60
				"65 CM" 65
				"70 CM" 70
				"75 CM" 75
				"80 CM" 80
				"85 CM" 85
				"90 CM" 90
				"95 CM" 95
				"100 CM" 100
				"105 CM" 105
				"110 CM" 110
				"115 CM" 115
				"120 CM" 120
				"125 CM" 125
				"130 CM" 130
				"135 CM" 135
				"140 CM" 140
				"145 CM" 145
				"150 CM" 150
			}
		}

		SwitchSprintStop
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 572
			navUp SwitchSprintStart
			navDown SwitchSprintAction
			ConVar "tf2vrbb_sprint_stop_cm"
			list
			{
				"0 CM" 0
				"5 CM" 5
				"10 CM" 10
				"15 CM" 15
				"20 CM" 20
				"25 CM" 25
				"30 CM" 30
				"35 CM" 35
				"40 CM" 40
				"45 CM" 45
				"50 CM" 50
				"55 CM" 55
				"60 CM" 60
				"65 CM" 65
				"70 CM" 70
				"75 CM" 75
				"80 CM" 80
				"85 CM" 85
				"90 CM" 90
				"95 CM" 95
				"100 CM" 100
				"105 CM" 105
				"110 CM" 110
				"115 CM" 115
				"120 CM" 120
				"125 CM" 125
				"130 CM" 130
				"135 CM" 135
				"140 CM" 140
				"145 CM" 145
			}
		}
		HintText
		{
			ControlName Label
			labelText "Sprint starts when your gun drops further than the start height below your eyes, and stops once it comes back above the stop height. Stop height is always kept below start height."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 50
			wrap 1
			xpos 152
			ypos 646
		}

		NoteText
		{
			ControlName Label
			labelText "Sprint needs the action enabled here and a binding on the left or right stick click, depending on how the layer is configured."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 50
			wrap 1
			xpos 152
			ypos 710
		}

		Status
		{
			ControlName Label
			labelText ""
			font Default_16
			fgcolor_override "242 141 28 255"
			allcaps 1
			wide 696
			tall 30
			xpos 152
			ypos 880
		}

		FooterButtons
		{
			ControlName CNestedPanel
			InheritProperties FooterButtons
		}
	}
}
