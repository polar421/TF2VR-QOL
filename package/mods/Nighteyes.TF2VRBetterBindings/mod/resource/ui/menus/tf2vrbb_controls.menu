"resource/ui/menus/tf2vrbb_controls.menu"
{
	menu
	{
		ControlName Frame
		xpos 0
		ypos 0
		zpos 3
		wide f0
		tall f0
		autoResize 0
		visible 1
		enabled 1
		pinCorner 0
		PaintBackgroundType 0
		infocus_bgcolor_override "0 0 0 0"
		outoffocus_bgcolor_override "0 0 0 0"

		Vignette
		{
			ControlName ImagePanel
			InheritProperties MenuVignette
		}

		ImgTopBar
		{
			ControlName ImagePanel
			InheritProperties MenuTopBar
		}

		Title
		{
			ControlName Label
			InheritProperties MenuTitle
			labelText "TF2VR QUALITY OF LIFE"
		}

		Screen
		{
			ControlName Label
			wide %100
			tall %100
			labelText ""
			visible 0
		}

		Panel
		{
			ControlName Label
			labelText ""
			zpos -1
			wide 760
			tall 800
			xpos 120
			ypos 280
			paintbackground 1
			bgcolor_override "8 10 12 232"
		}

		AccentTop
		{
			ControlName Label
			labelText ""
			wide 760
			tall 6
			paintbackground 1
			bgcolor_override "242 141 28 255"
			xpos 120
			ypos 280
		}

		PanelHeader
		{
			ControlName Label
			labelText "CONTROLS"
			font Default_41
			allcaps 1
			fgcolor_override "255 255 255 255"
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 152
			ypos 306
		}

		HeaderRule
		{
			ControlName Label
			labelText ""
			wide 696
			tall 2
			paintbackground 1
			bgcolor_override "96 104 112 255"
			xpos 152
			ypos 376
		}

		SubHeader
		{
			ControlName Label
			labelText "These actions are added to the Titanfall 2 VR gameplay action set. Bind them the same way you bind the mod's own actions; if your runtime has no binding for them they stay unbound."
			font Default_21
			fgcolor_override "176 182 188 255"
			wide 696
			tall 60
			wrap 1
			xpos 152
			ypos 388
		}

		Entry0
		{
			ControlName Label
			labelText "RELOAD GRAB      tf2vr_reload_grab      trigger, each hand"
			font Default_21
			fgcolor_override "255 255 255 255"
			wide 696
			tall 30
			xpos 152
			ypos 464
		}

		Desc0
		{
			ControlName Label
			labelText "Grabs magazines and racks slides with the trigger. Grip on that hand grabs nothing while you reload, so Grip only holds the gun."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 494
		}

		Entry1
		{
			ControlName Label
			labelText "CROUCH      tf2vr_crouch      any button"
			font Default_21
			fgcolor_override "255 255 255 255"
			wide 696
			tall 30
			xpos 152
			ypos 540
		}

		Desc1
		{
			ControlName Label
			labelText "Hold or toggle, depending on how the action is bound. Jumping out of a crouch can stand you up first; see Action Settings."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 570
		}

		Entry2
		{
			ControlName Label
			labelText "TACTICAL ABILITY (CLOAK)      tf2vr_tactical      any button"
			font Default_21
			fgcolor_override "255 255 255 255"
			wide 696
			tall 30
			xpos 152
			ypos 616
		}

		Desc2
		{
			ControlName Label
			labelText "Cloak from a button. The trigger of the hand without the gun can be blocked so it stops cloaking on its own."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 646
		}

		Entry3
		{
			ControlName Label
			labelText "SPRINT (OPTIONAL)      no new action      lower your gun below your eyes"
			font Default_21
			fgcolor_override "255 255 255 255"
			wide 696
			tall 30
			xpos 152
			ypos 692
		}

		Desc3
		{
			ControlName Label
			labelText "Drives the mod's own sprint button while your gun is held low. Heights are set in General Options."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 722
		}

		Entry4
		{
			ControlName Label
			labelText "GRENADE TOGGLE (OPTIONAL)      grip on the gun hand      press to take, press to throw"
			font Default_21
			fgcolor_override "255 255 255 255"
			wide 696
			tall 30
			xpos 152
			ypos 768
		}

		Desc4
		{
			ControlName Label
			labelText "Needs the mod's VR Settings, Gun Grip set to Toggle. Turned on in Action Settings."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 798
		}

		BtnBack
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			classname ModButton
			labelText "BACK"
			textAlignment center
			wide 260
			tall 54
			scriptID "0"
			xpos 152
			ypos 880
		}

		FooterButtons
		{
			ControlName CNestedPanel
			InheritProperties FooterButtons
		}
	}
}
