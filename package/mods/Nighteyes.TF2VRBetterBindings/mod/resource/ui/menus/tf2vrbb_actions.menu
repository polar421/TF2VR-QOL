"resource/ui/menus/tf2vrbb_actions.menu"
{
	menu
	{
		ControlName Frame
		xpos 0
		ypos 0
		zpos 3
		wide f0
		tall f0
		autoResize 0
		visible 1
		enabled 1
		pinCorner 0
		PaintBackgroundType 0
		infocus_bgcolor_override "0 0 0 0"
		outoffocus_bgcolor_override "0 0 0 0"

		Vignette
		{
			ControlName ImagePanel
			InheritProperties MenuVignette
		}

		ImgTopBar
		{
			ControlName ImagePanel
			InheritProperties MenuTopBar
		}

		Title
		{
			ControlName Label
			InheritProperties MenuTitle
			labelText "TF2VR QUALITY OF LIFE"
		}

		Screen
		{
			ControlName Label
			wide %100
			tall %100
			labelText ""
			visible 0
		}

		Panel
		{
			ControlName Label
			labelText ""
			zpos -1
			wide 760
			tall 800
			xpos 120
			ypos 280
			paintbackground 1
			bgcolor_override "8 10 12 232"
		}

		AccentTop
		{
			ControlName Label
			labelText ""
			wide 760
			tall 6
			paintbackground 1
			bgcolor_override "242 141 28 255"
			xpos 120
			ypos 280
		}

		PanelHeader
		{
			ControlName Label
			labelText "ACTION SETTINGS"
			font Default_41
			allcaps 1
			fgcolor_override "255 255 255 255"
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 152
			ypos 306
		}

		HeaderRule
		{
			ControlName Label
			labelText ""
			wide 696
			tall 2
			paintbackground 1
			bgcolor_override "96 104 112 255"
			xpos 152
			ypos 376
		}

		SubHeader
		{
			ControlName Label
			labelText "Select a row to change its value. Every value below is read by the OpenXR layer."
			font Default_21
			fgcolor_override "176 182 188 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 392
		}

		SwitchReloadGrab
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 432
			navUp SwitchTacticalBlockTrigger
			navDown SwitchGrenadeToggle
			ConVar "tf2vrbb_reload_grab"
			list
			{
				"OFF" 0
				"ON" 1
			}
		}

		SwitchGrenadeToggle
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 494
			navUp SwitchReloadGrab
			navDown SwitchCrouchAction
			ConVar "tf2vrbb_grenade_toggle"
			list
			{
				"OFF" 0
				"ON" 1
			}
		}

		SwitchCrouchAction
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 556
			navUp SwitchGrenadeToggle
			navDown SwitchCrouchMode
			ConVar "tf2vrbb_crouch_enabled"
			list
			{
				"OFF" 0
				"ON" 1
			}
		}

		SwitchCrouchMode
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 618
			navUp SwitchCrouchAction
			navDown SwitchCrouchBinding
			ConVar "tf2vrbb_crouch_button_mode"
			list
			{
				"TOGGLE" 0
				"BUTTON" 1
			}
		}

		SwitchCrouchBinding
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 680
			navUp SwitchCrouchMode
			navDown SwitchUncrouchOnJump
			ConVar "tf2vrbb_crouch_binding"
			list
			{
				"NONE" 0
				"LEFT STICK CLICK" 1
				"RIGHT STICK CLICK" 2
				"BOTH STICK CLICKS" 3
			}
		}

		SwitchUncrouchOnJump
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 742
			navUp SwitchCrouchBinding
			navDown SwitchJumpDelay
			ConVar "tf2vrbb_uncrouch_on_jump"
			list
			{
				"OFF" 0
				"ON" 1
			}
		}

		SwitchJumpDelay
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 804
			navUp SwitchUncrouchOnJump
			navDown SwitchTacticalAction
			ConVar "tf2vrbb_jump_delay_ms"
			list
			{
				"0 MS" 0
				"50 MS" 50
				"100 MS" 100
				"150 MS" 150
				"200 MS" 200
				"250 MS" 250
				"300 MS" 300
				"350 MS" 350
				"400 MS" 400
				"450 MS" 450
				"500 MS" 500
				"550 MS" 550
				"600 MS" 600
				"650 MS" 650
				"700 MS" 700
				"750 MS" 750
				"800 MS" 800
				"850 MS" 850
				"900 MS" 900
				"950 MS" 950
				"1000 MS" 1000
			}
		}

		SwitchTacticalAction
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 866
			navUp SwitchJumpDelay
			navDown SwitchTacticalBlockTrigger
			ConVar "tf2vrbb_tactical_enabled"
			list
			{
				"OFF" 0
				"ON" 1
			}
		}

		SwitchTacticalBlockTrigger
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			style DialogListButton
			wide 696
			xpos 152
			ypos 928
			navUp SwitchTacticalAction
			navDown SwitchReloadGrab
			ConVar "tf2vrbb_tactical_block_trigger"
			list
			{
				"OFF" 0
				"ON" 1
			}
		}
		HintText
		{
			ControlName Label
			labelText "Crouch Binding is applied by the OpenXR layer after a restart. Crouch Mode controls toggle vs hold."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 30
			wrap 1
			xpos 152
			ypos 982
		}

		Status
		{
			ControlName Label
			labelText ""
			font Default_16
			fgcolor_override "242 141 28 255"
			allcaps 1
			wide 696
			tall 30
			xpos 152
			ypos 1012
		}

		FooterButtons
		{
			ControlName CNestedPanel
			InheritProperties FooterButtons
		}
	}
}
