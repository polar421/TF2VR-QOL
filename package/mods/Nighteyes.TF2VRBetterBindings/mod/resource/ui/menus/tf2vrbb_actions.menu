"resource/ui/menus/tf2vrbb_actions.menu"
{
	menu
	{
		ControlName Frame
		xpos 0
		ypos 0
		zpos 3
		wide f0
		tall f0
		autoResize 0
		visible 1
		enabled 1
		pinCorner 0
		PaintBackgroundType 0
		infocus_bgcolor_override "0 0 0 0"
		outoffocus_bgcolor_override "0 0 0 0"

		Vignette
		{
			ControlName ImagePanel
			InheritProperties MenuVignette
		}

		ImgTopBar
		{
			ControlName ImagePanel
			InheritProperties MenuTopBar
		}

		Title
		{
			ControlName Label
			InheritProperties MenuTitle
			labelText "TF2VR BETTER BINDINGS"
		}

		Screen
		{
			ControlName Label
			wide %100
			tall %100
			labelText ""
			visible 0
		}

		Panel
		{
			ControlName Label
			labelText ""
			zpos -1
			wide 560
			tall 700
			xpos -280
			ypos -350
			paintbackground 1
			bgcolor_override "8 10 12 232"
			pin_to_sibling Screen
			pin_corner_to_sibling CENTER
			pin_to_sibling_corner CENTER
		}

		AccentTop
		{
			ControlName Label
			labelText ""
			wide 560
			tall 6
			paintbackground 1
			bgcolor_override "242 141 28 255"
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		PanelHeader
		{
			ControlName Label
			labelText "ACTION SETTINGS"
			font Default_41
			allcaps 1
			fgcolor_override "255 255 255 255"
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 32
			ypos 26
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		HeaderRule
		{
			ControlName Label
			labelText ""
			wide 496
			tall 2
			paintbackground 1
			bgcolor_override "96 104 112 255"
			xpos 32
			ypos 96
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		SubHeader
		{
			ControlName Label
			labelText "Select a row to change its value. Every value below is read by the OpenXR layer."
			font Default_21
			fgcolor_override "176 182 188 255"
			wide 496
			tall 30
			wrap 1
			xpos 32
			ypos 112
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row0
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "RELOAD GRAB"
			textAlignment west
			wide 496
			tall 52
			scriptID "0"
			xpos 32
			ypos 152
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row1
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "GRENADE TOGGLE"
			textAlignment west
			wide 496
			tall 52
			scriptID "1"
			xpos 32
			ypos 214
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row2
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "CROUCH ACTION"
			textAlignment west
			wide 496
			tall 52
			scriptID "2"
			xpos 32
			ypos 276
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row3
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "CROUCH MODE"
			textAlignment west
			wide 496
			tall 52
			scriptID "3"
			xpos 32
			ypos 338
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row4
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "UNCROUCH ON JUMP"
			textAlignment west
			wide 496
			tall 52
			scriptID "4"
			xpos 32
			ypos 400
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row5
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "JUMP DELAY"
			textAlignment west
			wide 496
			tall 52
			scriptID "5"
			xpos 32
			ypos 462
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row6
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "TACTICAL ACTION"
			textAlignment west
			wide 496
			tall 52
			scriptID "6"
			xpos 32
			ypos 524
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Row7
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "TACTICAL BLOCKS HAND TRIGGER"
			textAlignment west
			wide 496
			tall 52
			scriptID "7"
			xpos 32
			ypos 586
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		HintText
		{
			ControlName Label
			labelText "Crouch mode must match how CROUCH is bound: TOGGLE for a toggle binding, BUTTON for a hold binding."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 496
			tall 30
			wrap 1
			xpos 32
			ypos 640
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Status
		{
			ControlName Label
			labelText ""
			font Default_16
			fgcolor_override "242 141 28 255"
			allcaps 1
			wide 496
			tall 30
			xpos 32
			ypos 670
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		FooterButtons
		{
			ControlName CNestedPanel
			InheritProperties FooterButtons
		}
	}
}
