"resource/ui/menus/tf2vrbb_about.menu"
{
	menu
	{
		ControlName Frame
		xpos 0
		ypos 0
		zpos 3
		wide f0
		tall f0
		autoResize 0
		visible 1
		enabled 1
		pinCorner 0
		PaintBackgroundType 0
		infocus_bgcolor_override "0 0 0 0"
		outoffocus_bgcolor_override "0 0 0 0"

		Vignette
		{
			ControlName ImagePanel
			InheritProperties MenuVignette
		}

		ImgTopBar
		{
			ControlName ImagePanel
			InheritProperties MenuTopBar
		}

		Title
		{
			ControlName Label
			InheritProperties MenuTitle
			labelText "TF2VR BETTER BINDINGS"
		}

		Screen
		{
			ControlName Label
			wide %100
			tall %100
			labelText ""
			visible 0
		}

		Panel
		{
			ControlName Label
			labelText ""
			zpos -1
			wide 760
			tall 800
			xpos 120
			ypos 120
			paintbackground 1
			bgcolor_override "8 10 12 232"
		}

		AccentTop
		{
			ControlName Label
			labelText ""
			wide 760
			tall 6
			paintbackground 1
			bgcolor_override "242 141 28 255"
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		PanelHeader
		{
			ControlName Label
			labelText "ABOUT"
			font Default_41
			allcaps 1
			fgcolor_override "255 255 255 255"
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 32
			ypos 26
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		HeaderRule
		{
			ControlName Label
			labelText ""
			wide 696
			tall 2
			paintbackground 1
			bgcolor_override "96 104 112 255"
			xpos 32
			ypos 96
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		VersionLabel
		{
			ControlName Label
			labelText "TF2VR BETTER BINDINGS"
			font Default_21
			fgcolor_override "242 141 28 255"
			allcaps 1
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 32
			ypos 124
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		BodyText
		{
			ControlName Label
			labelText "Extra OpenXR actions and optional features for CircuitLord's Titanfall 2 VR mod. Nothing in the game is modified; the add-on is an OpenXR API layer plus a Northstar mod and plugin."
			font Default_16
			fgcolor_override "214 220 226 255"
			wide 696
			tall 40
			wrap 1
			xpos 32
			ypos 160
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		BodyText2
		{
			ControlName Label
			labelText "The OpenXR layer reads TF2VRBetterBindings.ini next to TF2VRBetterBindingsLayer.dll. This menu writes the same file through the mod's Northstar plugin, so no second settings store is used."
			font Default_16
			fgcolor_override "214 220 226 255"
			wide 696
			tall 40
			wrap 1
			xpos 32
			ypos 212
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		BodyText3
		{
			ControlName Label
			labelText "Requires Northstar and Titanfall 2 VR. SteamVR is not required by this add-on; WiVRn and Monado work with it as long as the runtime loads the OpenXR API layer."
			font Default_16
			fgcolor_override "214 220 226 255"
			wide 696
			tall 40
			wrap 1
			xpos 32
			ypos 264
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		CreditsLabel
		{
			ControlName Label
			labelText "CircuitLord for Titanfall 2 VR. Northstar for the plugin and mod interface. MIT licensed."
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 30
			wrap 1
			xpos 32
			ypos 320
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		StorageLabel
		{
			ControlName Label
			labelText ""
			font Default_16
			fgcolor_override "150 156 162 255"
			allcaps 1
			wide 696
			tall 30
			xpos 32
			ypos 370
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		BtnBack
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			labelText "BACK"
			textAlignment center
			wide 260
			tall 54
			scriptID "0"
			xpos 32
			ypos 600
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		FooterButtons
		{
			ControlName CNestedPanel
			InheritProperties FooterButtons
		}
	}
}
