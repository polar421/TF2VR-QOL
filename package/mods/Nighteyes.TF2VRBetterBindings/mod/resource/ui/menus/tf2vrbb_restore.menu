"resource/ui/menus/tf2vrbb_restore.menu"
{
	menu
	{
		ControlName Frame
		xpos 0
		ypos 0
		zpos 3
		wide f0
		tall f0
		autoResize 0
		visible 1
		enabled 1
		pinCorner 0
		PaintBackgroundType 0
		infocus_bgcolor_override "0 0 0 0"
		outoffocus_bgcolor_override "0 0 0 0"

		Vignette
		{
			ControlName ImagePanel
			InheritProperties MenuVignette
		}

		ImgTopBar
		{
			ControlName ImagePanel
			InheritProperties MenuTopBar
		}

		Title
		{
			ControlName Label
			InheritProperties MenuTitle
			labelText "TF2VR BETTER BINDINGS"
		}

		Screen
		{
			ControlName Label
			wide %100
			tall %100
			labelText ""
			visible 0
		}

		Panel
		{
			ControlName Label
			labelText ""
			zpos -1
			wide 760
			tall 800
			xpos 120
			ypos 280
			paintbackground 1
			bgcolor_override "8 10 12 232"
		}

		AccentTop
		{
			ControlName Label
			labelText ""
			wide 760
			tall 6
			paintbackground 1
			bgcolor_override "242 141 28 255"
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		PanelHeader
		{
			ControlName Label
			labelText "RESTORE DEFAULTS"
			font Default_41
			allcaps 1
			fgcolor_override "255 255 255 255"
			auto_wide_tocontents 1
			auto_tall_tocontents 1
			xpos 32
			ypos 26
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		HeaderRule
		{
			ControlName Label
			labelText ""
			wide 696
			tall 2
			paintbackground 1
			bgcolor_override "96 104 112 255"
			xpos 32
			ypos 96
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		WarningText
		{
			ControlName Label
			labelText "This resets every setting in this menu to the values below and writes them to TF2VRBetterBindings.ini. Your other settings in that file are kept."
			font Default_21
			fgcolor_override "214 220 226 255"
			wide 696
			tall 60
			wrap 1
			xpos 32
			ypos 124
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		DefaultsText
		{
			ControlName Label
			labelText "Reload Grab ON   |   Grenade Toggle OFF   |   Crouch ON, TOGGLE   |   Uncrouch on Jump OFF   |   Jump Delay 250 ms   |   Tactical ON, blocks hand trigger   |   Sprint OFF, 30 cm start, 20 cm stop"
			font Default_16
			fgcolor_override "150 156 162 255"
			wide 696
			tall 60
			wrap 1
			xpos 32
			ypos 196
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		BtnRestore
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			classname ModButton
			labelText "RESTORE DEFAULTS"
			textAlignment center
			wide 360
			tall 54
			scriptID "0"
			xpos 32
			ypos 300
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		BtnCancel
		{
			ControlName RuiButton
			InheritProperties RuiSmallButton
			classname ModButton
			labelText "CANCEL"
			textAlignment center
			wide 360
			tall 54
			scriptID "1"
			xpos 32
			ypos 366
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		Status
		{
			ControlName Label
			labelText ""
			font Default_16
			fgcolor_override "242 141 28 255"
			allcaps 1
			wide 696
			tall 30
			xpos 32
			ypos 480
			pin_to_sibling Panel
			pin_corner_to_sibling TOP_LEFT
			pin_to_sibling_corner TOP_LEFT
		}

		FooterButtons
		{
			ControlName CNestedPanel
			InheritProperties FooterButtons
		}
	}
}
